{
  "sections": {
    "konvert-urgency-bar": {
      "type": "konvert-urgency-bar",
      "settings": {
        "message_default": "Commande avant 17h : expédition aujourd'hui",
        "message_with_stock": "Il reste [count] en stock — commande vite",
        "show_stock_count": true,
        "only_show_when_low_stock": false,
        "stock_threshold": 10,
        "show_countdown": false,
        "countdown_minutes": 15,
        "color_scheme": "scheme-1",
        "background_color": "#FFF4E5",
        "text_color": "#7A4A00",
        "accent_color": "#E8590C"
      }
    },
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "caption": {
          "type": "text",
          "settings": {
            "text": "{{ product.metafields.descriptors.subtitle.value }}",
            "text_style": "subtitle"
          }
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "collapsible-row-0": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Materials",
            "icon": "leather",
            "content": "",
            "page": ""
          }
        },
        "collapsible-row-1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & Returns",
            "icon": "truck",
            "content": "",
            "page": ""
          }
        },
        "collapsible-row-2": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Dimensions",
            "icon": "ruler",
            "content": "",
            "page": ""
          }
        },
        "collapsible-row-3": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Care Instructions",
            "icon": "heart",
            "content": "",
            "page": ""
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "caption",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "collapsible-row-0",
        "collapsible-row-1",
        "collapsible-row-2",
        "collapsible-row-3",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "konvert-comparison-table": {
      "type": "konvert-comparison-table",
      "blocks": {
        "row-0": {
          "type": "comparison_row",
          "settings": {
            "label": "Suivi de commande",
            "us_value": "yes",
            "them_value": "custom",
            "them_text": "[à vérifier]"
          }
        },
        "row-1": {
          "type": "comparison_row",
          "settings": {
            "label": "Paiement sécurisé",
            "us_value": "yes",
            "them_value": "custom",
            "them_text": "[à vérifier]"
          }
        },
        "row-2": {
          "type": "comparison_row",
          "settings": {
            "label": "Délai de livraison",
            "us_value": "custom",
            "us_text": "[Précisez votre délai réel, ex. 5-8 jours]",
            "them_value": "custom",
            "them_text": "[Variable]"
          }
        },
        "row-3": {
          "type": "comparison_row",
          "settings": {
            "label": "Service client",
            "us_value": "custom",
            "us_text": "[Précisez votre délai de réponse réel, ex. sous 24h]",
            "them_value": "custom",
            "them_text": "[Variable]"
          }
        }
      },
      "block_order": ["row-0", "row-1", "row-2", "row-3"],
      "settings": {
        "heading": "Pourquoi choisir [Nom de votre marque]",
        "subheading": "Comparé à une boutique classique",
        "criteria_column_label": "Critère",
        "us_column_label": "[Nom de votre marque]",
        "them_column_label": "Boutique classique",
        "color_scheme": "scheme-1",
        "heading_color": "#1A1A1A",
        "us_column_color": "#EFF7EE",
        "us_accent_color": "#2F8132",
        "border_color": "#E5E5E5"
      }
    },
    "konvert-testimonials-carousel": {
      "type": "konvert-testimonials-carousel",
      "blocks": {
        "testimonial-0": {
          "type": "testimonial",
          "settings": {
            "author_name": "[Remplacez par un prénom/nom de client réel]",
            "rating": 0,
            "date": "",
            "quote": "[Remplacez par un avis client réel — ne publiez jamais un témoignage fictif]"
          }
        },
        "testimonial-1": {
          "type": "testimonial",
          "settings": {
            "author_name": "[Remplacez par un prénom/nom de client réel]",
            "rating": 0,
            "date": "",
            "quote": "[Remplacez par un avis client réel — ne publiez jamais un témoignage fictif]"
          }
        },
        "testimonial-2": {
          "type": "testimonial",
          "settings": {
            "author_name": "[Remplacez par un prénom/nom de client réel]",
            "rating": 0,
            "date": "",
            "quote": "[Remplacez par un avis client réel — ne publiez jamais un témoignage fictif]"
          }
        }
      },
      "block_order": ["testimonial-0", "testimonial-1", "testimonial-2"],
      "settings": {
        "heading": "Ils l'ont adopté",
        "color_scheme": "scheme-1",
        "background_color": "#FFFFFF",
        "text_color": "#1A1A1A",
        "star_color": "#E8590C",
        "accent_color": "#1A1A1A"
      }
    },
    "konvert-social-proof": {
      "type": "konvert-social-proof",
      "settings": {
        "proof_type": "custom_text",
        "proof_number": "",
        "proof_label": "",
        "custom_text": "[Complétez avec un chiffre réel, ex. « 1 200+ clients satisfaits depuis 2024 »]",
        "color_scheme": "scheme-1",
        "text_color": "#1A1A1A",
        "number_color": "#1A1A1A"
      }
    },
    "konvert-founder-story": {
      "type": "konvert-founder-story",
      "settings": {
        "heading": "Pourquoi on a créé [Nom de votre marque]",
        "story": "<p>Tout a commencé quand [décrivez le déclic réel : une frustration, une découverte, un besoin non résolu].</p><p>On a testé, raté, recommencé — jusqu'à trouver [nom du produit ou de la gamme]. [Ajoutez ici ce qui rend votre démarche différente : sourcing, qualité, service client...]</p><p>Aujourd'hui, [décrivez où vous en êtes et votre mission actuelle].</p>",
        "founder_name": "",
        "founder_role": "Fondateur",
        "enable_video_looping": false,
        "media_position": "left",
        "color_scheme": "scheme-1",
        "heading_color": "#1A1A1A",
        "text_color": "#3A3A3A",
        "accent_color": "#1A1A1A"
      }
    },
    "konvert-faq-rich": {
      "type": "konvert-faq-rich",
      "blocks": {
        "question-0": {
          "type": "question",
          "settings": {
            "question": "Combien de temps avant de recevoir ma commande ?",
            "answer": "<p>Votre commande est traitée sous [délai de traitement réel] puis expédiée. Le délai de livraison est de [délai réel, ex. 5 à 10 jours ouvrés] selon votre pays. Vous recevez un numéro de suivi par email dès l'expédition.</p>"
          }
        },
        "question-1": {
          "type": "question",
          "settings": {
            "question": "Puis-je retourner le produit s'il ne me convient pas ?",
            "answer": "<p>[Décrivez votre politique de retour réelle : délai, conditions, qui paie le retour.]</p>"
          }
        },
        "question-2": {
          "type": "question",
          "settings": {
            "question": "Quels moyens de paiement acceptez-vous ?",
            "answer": "<p>Nous acceptons [moyens de paiement réellement activés sur votre boutique, ex. carte bancaire, PayPal, Apple Pay].</p>"
          }
        },
        "question-3": {
          "type": "question",
          "settings": {
            "question": "Comment suivre ma commande ?",
            "answer": "<p>Dès l'expédition, vous recevez un email avec un lien de suivi en temps réel. [Précisez le ou les transporteurs utilisés si besoin.]</p>"
          }
        },
        "question-4": {
          "type": "question",
          "settings": {
            "question": "Le produit est-il garanti ?",
            "answer": "<p>[Décrivez votre garantie réelle si vous en proposez une — durée, ce qui est couvert.]</p>"
          }
        },
        "question-5": {
          "type": "question",
          "settings": {
            "question": "Le colis est-il discret / bien protégé ?",
            "answer": "<p>[Décrivez votre emballage réel si c'est un argument pertinent pour votre produit.]</p>"
          }
        }
      },
      "block_order": [
        "question-0",
        "question-1",
        "question-2",
        "question-3",
        "question-4",
        "question-5"
      ],
      "settings": {
        "heading": "Questions fréquentes",
        "open_first_item": false,
        "color_scheme": "scheme-1",
        "heading_color": "#1A1A1A",
        "accent_color": "#1A1A1A",
        "border_color": "#E5E5E5"
      }
    },
    "konvert-sticky-atc-mobile": {
      "type": "konvert-sticky-atc-mobile",
      "settings": {
        "show_thumbnail": true,
        "add_to_cart_label": "Je le veux",
        "sold_out_label": "Rupture de stock",
        "color_scheme": "scheme-1",
        "background_color": "#FFFFFF",
        "text_color": "#1A1A1A",
        "border_color": "#E5E5E5"
      }
    },
    "konvert-guarantees": {
      "type": "konvert-guarantees",
      "blocks": {
        "guarantee-0": {
          "type": "guarantee",
          "settings": {
            "icon": "truck",
            "title": "Livraison suivie",
            "text": "<p>Votre commande est expédiée sous [délai de traitement réel] avec un numéro de suivi envoyé par email.</p>"
          }
        },
        "guarantee-1": {
          "type": "guarantee",
          "settings": {
            "icon": "return",
            "title": "Retours faciles",
            "text": "<p>Un souci ? Vous avez [délai réel, ex. 14 jours] pour nous contacter et organiser un retour.</p>"
          }
        },
        "guarantee-2": {
          "type": "guarantee",
          "settings": {
            "icon": "lock",
            "title": "Paiement 100% sécurisé",
            "text": "<p>Vos données bancaires sont protégées. Paiement via [moyens réellement activés, ex. Shopify Payments, PayPal].</p>"
          }
        },
        "guarantee-3": {
          "type": "guarantee",
          "settings": {
            "icon": "chat_bubble",
            "title": "Support réactif",
            "text": "<p>Une question avant ou après votre achat ? Notre équipe répond sous [délai réel, ex. 24h] par email.</p>"
          }
        }
      },
      "block_order": ["guarantee-0", "guarantee-1", "guarantee-2", "guarantee-3"],
      "settings": {
        "heading": "Nos garanties",
        "columns_desktop": 4,
        "scroll_on_mobile": true,
        "color_scheme": "scheme-1",
        "heading_color": "#1A1A1A",
        "icon_color": "#1A1A1A",
        "title_color": "#1A1A1A",
        "text_color": "#5C5C5C"
      }
    },
    "image-with-text": {
      "type": "image-with-text",
      "blocks": {
        "image-with-text-0": {
          "type": "heading",
          "settings": {
            "heading": "Image with text",
            "heading_size": "h1"
          }
        },
        "image-with-text-1": {
          "type": "text",
          "settings": {
            "text": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.<\/p>",
            "text_style": "body"
          }
        }
      },
      "block_order": [
        "image-with-text-0",
        "image-with-text-1"
      ],
      "settings": {
        "height": "small",
        "desktop_image_width": "medium",
        "layout": "text_first",
        "desktop_content_position": "top",
        "desktop_content_alignment": "left",
        "content_layout": "no-overlap",
        "color_scheme": "scheme-2",
        "mobile_content_alignment": "left",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
