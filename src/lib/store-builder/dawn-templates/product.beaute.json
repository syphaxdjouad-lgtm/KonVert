    "konvert-guarantees": {
      "type": "konvert-guarantees",
      "blocks": {
        "guarantee-0": {
          "type": "guarantee",
          "settings": {
            "icon": "truck",
            "title": "Livraison soignée",
            "text": "<p>Votre commande part sous [délai de traitement réel], emballée avec soin. Vous suivez chaque étape par email.</p>"
          }
        },
        "guarantee-1": {
          "type": "guarantee",
          "settings": {
            "icon": "return",
            "title": "Satisfait ou remboursé",
            "text": "<p>Le produit ne vous convient pas ? Vous avez [délai réel, ex. 30 jours] pour le retourner. [Précisez si un produit entamé est accepté.]</p>"
          }
        },
        "guarantee-2": {
          "type": "guarantee",
          "settings": {
            "icon": "lock",
            "title": "Paiement sécurisé",
            "text": "<p>Vos informations bancaires sont chiffrées et protégées à chaque commande.</p>"
          }
        },
        "guarantee-3": {
          "type": "guarantee",
          "settings": {
            "icon": "chat_bubble",
            "title": "Une question sur votre peau ?",
            "text": "<p>Notre équipe vous répond sous [délai réel] pour vous aider à choisir la routine adaptée.</p>"
          }
        }
      },
      "block_order": ["guarantee-0", "guarantee-1", "guarantee-2", "guarantee-3"],
      "settings": {
        "heading": "Nos engagements",
        "columns_desktop": 4,
        "scroll_on_mobile": true,
        "color_scheme": "scheme-1",
        "heading_color": "#1A1A1A",
        "icon_color": "#1A1A1A",
        "title_color": "#1A1A1A",
        "text_color": "#5C5C5C"
