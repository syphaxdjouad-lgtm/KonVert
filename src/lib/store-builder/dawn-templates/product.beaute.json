{
  "sections": {
    "konvert-urgency-bar": {
      "type": "konvert-urgency-bar",
      "settings": {
        "message_default": "Commande avant 17h, expédiée aujourd'hui avec soin",
        "message_with_stock": "Il reste [count] en stock ce mois-ci",
        "show_stock_count": true,
        "only_show_when_low_stock": false,
        "stock_threshold": 10,
        "show_countdown": false,
        "countdown_minutes": 15,
        "color_scheme": "scheme-1",
        "background_color": "#FFF4E5",
        "text_color": "#7A4A00",
        "accent_color": "#E8590C"
      }
    },
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "caption": {
          "type": "text",
          "settings": {
            "text": "{{ product.metafields.descriptors.subtitle.value }}",
            "text_style": "subtitle"
          }
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "collapsible-row-0": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Materials",
            "icon": "leather",
            "content": "",
            "page": ""
          }
        },
        "collapsible-row-1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & Returns",
            "icon": "truck",
            "content": "",
            "page": ""
          }
        },
        "collapsible-row-2": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Dimensions",
            "icon": "ruler",
            "content": "",
            "page": ""
          }
        },
        "collapsible-row-3": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Care Instructions",
            "icon": "heart",
            "content": "",
            "page": ""
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "caption",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "collapsible-row-0",
        "collapsible-row-1",
        "collapsible-row-2",
        "collapsible-row-3",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "konvert-comparison-table": {
      "type": "konvert-comparison-table",
      "blocks": {
        "row-0": {
          "type": "comparison_row",
          "settings": {
            "label": "Liste INCI complète et transparente",
            "us_value": "yes",
            "them_value": "custom",
            "them_text": "[à vérifier]"
          }
        },
        "row-1": {
          "type": "comparison_row",
          "settings": {
            "label": "Testé dermatologiquement",
            "us_value": "custom",
            "us_text": "[Cochez \"Oui\" uniquement si vous avez un certificat/test réel]",
            "them_value": "custom",
            "them_text": "[Variable]"
          }
        },
        "row-2": {
          "type": "comparison_row",
          "settings": {
            "label": "Sans [ingrédient controversé pertinent pour votre formule, ex. parabènes]",
            "us_value": "custom",
            "us_text": "[Précisez si applicable à votre formule réelle]",
            "them_value": "custom",
            "them_text": "[Variable]"
          }
        },
        "row-3": {
          "type": "comparison_row",
          "settings": {
            "label": "Politique de retour",
            "us_value": "custom",
            "us_text": "[Précisez votre délai réel, ex. 30 jours]",
            "them_value": "custom",
            "them_text": "[Variable]"
          }
        }
      },
      "block_order": ["row-0", "row-1", "row-2", "row-3"],
      "settings": {
        "heading": "Pourquoi choisir [Nom de votre marque]",
        "subheading": "Comparé à une alternative générique",
        "criteria_column_label": "Critère",
        "us_column_label": "[Nom de votre marque]",
        "them_column_label": "Alternative générique",
        "color_scheme": "scheme-1",
        "heading_color": "#1A1A1A",
        "us_column_color": "#EFF7EE",
        "us_accent_color": "#2F8132",
        "border_color": "#E5E5E5"
      }
    },
    "konvert-testimonials-carousel": {
      "type": "konvert-testimonials-carousel",
      "blocks": {
        "testimonial-0": {
          "type": "testimonial",
          "settings": {
            "author_name": "[Remplacez par un prénom/nom de client réel]",
            "rating": 0,
            "date": "",
            "quote": "[Remplacez par un avis client réel — ne publiez jamais un témoignage fictif]"
          }
        },
        "testimonial-1": {
          "type": "testimonial",
          "settings": {
            "author_name": "[Remplacez par un prénom/nom de client réel]",
            "rating": 0,
            "date": "",
            "quote": "[Remplacez par un avis client réel — ne publiez jamais un témoignage fictif]"
          }
        },
        "testimonial-2": {
          "type": "testimonial",
          "settings": {
            "author_name": "[Remplacez par un prénom/nom de client réel]",
            "rating": 0,
            "date": "",
            "quote": "[Remplacez par un avis client réel — ne publiez jamais un témoignage fictif]"
          }
        }
      },
      "block_order": ["testimonial-0", "testimonial-1", "testimonial-2"],
      "settings": {
        "heading": "Ce que ses clientes en disent",
        "color_scheme": "scheme-1",
        "background_color": "#FFFFFF",
        "text_color": "#1A1A1A",
        "star_color": "#E8590C",
        "accent_color": "#1A1A1A"
      }
    },
    "konvert-social-proof": {
      "type": "konvert-social-proof",
      "settings": {
        "proof_type": "custom_text",
        "proof_number": "",
        "proof_label": "",
        "custom_text": "[Complétez avec un chiffre réel, ex. « Adoptée par 800+ peaux depuis son lancement »]",
        "color_scheme": "scheme-1",
        "text_color": "#1A1A1A",
        "number_color": "#1A1A1A"
      }
    },
    "konvert-founder-story": {
      "type": "konvert-founder-story",
      "settings": {
        "heading": "Notre histoire",
        "story": "<p>Tout a commencé quand [décrivez le déclic réel : une peau difficile à satisfaire, une routine qui ne fonctionnait jamais, une rencontre avec un ingrédient].</p><p>On a voulu une formule [décrivez votre exigence réelle : sans ingrédient controversé, testée, transparente sur les ingrédients].</p><p>Aujourd'hui, [décrivez votre mission actuelle et votre engagement réel envers vos clientes].</p>",
        "founder_name": "",
        "founder_role": "Fondatrice",
        "enable_video_looping": false,
        "media_position": "left",
        "color_scheme": "scheme-1",
        "heading_color": "#1A1A1A",
        "text_color": "#3A3A3A",
        "accent_color": "#1A1A1A"
      }
    },
    "konvert-faq-rich": {
      "type": "konvert-faq-rich",
      "blocks": {
        "question-0": {
          "type": "question",
          "settings": {
            "question": "Ce produit convient-il à mon type de peau ?",
            "answer": "<p>[Précisez les types de peau testés/recommandés pour votre formule réelle.] En cas de doute, faites un test sur une petite zone du bras 48h avant la première application complète.</p>"
          }
        },
        "question-1": {
          "type": "question",
          "settings": {
            "question": "Quels sont les ingrédients ?",
            "answer": "<p>La liste complète des ingrédients (INCI) est disponible sur l'emballage et sur la fiche produit. [Personnalisez avec vos ingrédients actifs réels et leur rôle.]</p>"
          }
        },
        "question-2": {
          "type": "question",
          "settings": {
            "question": "Sous combien de temps puis-je voir un effet ?",
            "answer": "<p>[Indiquez un délai réaliste basé sur vos propres retours ou ceux de votre fournisseur — évitez toute promesse de résultat garanti, chaque peau réagit différemment.]</p>"
          }
        },
        "question-3": {
          "type": "question",
          "settings": {
            "question": "Le produit est-il testé dermatologiquement ?",
            "answer": "<p>[Répondez uniquement si vous avez un certificat réel. Si ce n'est pas le cas, indiquez-le honnêtement plutôt que de laisser un doute.]</p>"
          }
        },
        "question-4": {
          "type": "question",
          "settings": {
            "question": "Quelle est votre politique de retour ?",
            "answer": "<p>[Décrivez votre politique de retour réelle : délai, produit entamé accepté ou non, qui paie le retour.]</p>"
          }
        },
        "question-5": {
          "type": "question",
          "settings": {
            "question": "Comment conserver le produit après ouverture ?",
            "answer": "<p>[Précisez la durée de conservation après ouverture (symbole PAO) indiquée sur votre emballage.]</p>"
          }
        }
      },
      "block_order": [
        "question-0",
        "question-1",
        "question-2",
        "question-3",
        "question-4",
        "question-5"
      ],
      "settings": {
        "heading": "Questions fréquentes",
        "open_first_item": false,
        "color_scheme": "scheme-1",
        "heading_color": "#1A1A1A",
        "accent_color": "#1A1A1A",
        "border_color": "#E5E5E5"
      }
    },
    "konvert-sticky-atc-mobile": {
      "type": "konvert-sticky-atc-mobile",
      "settings": {
        "show_thumbnail": true,
