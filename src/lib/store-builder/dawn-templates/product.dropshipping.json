        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "konvert-exit-intent": {
      "type": "konvert-exit-intent",
      "settings": {
        "heading": "Avant de partir...",
        "text": "<p>[Nom du produit] pourrait ne plus être en stock la prochaine fois. [Ajoutez votre offre réelle ici si vous en avez une.]</p>",
        "promo_code": "",
