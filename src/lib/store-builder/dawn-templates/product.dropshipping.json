        "background_color": "#FFFFFF",
        "text_color": "#1A1A1A",
        "accent_color": "#1A1A1A"
      }
    }
  },
  "order": [
    "konvert-urgency-bar",
    "main",
    "konvert-sticky-atc-mobile",
    "konvert-guarantees",
    "konvert-comparison-table",
